  m_Script: {fileID: 11500000, guid: 4e3a01c68164e434fa31b7fb3282deb3, type: 3}
  m_Name: GuideContent
  m_EditorClassIdentifier: Assembly-CSharp::GuideContent
  windowTitle: "\uC870\uC791 \uAC00\uC774\uB4DC"
  buttonLabel: "\uC870\uC791 \uAC00\uC774\uB4DC"
  tabs:
  - "\uC870\uC791"
  - "\uC0AC\uC218"
  - "\uAC80\uC0AC"
  - "\uC2A4\uD0AC\uACFC \uC0C1\uC704 \uBB34\uAE30"
  - "\uC544\uC774\uD15C"
  leads:
  - "\uACF5\uACA9\uC740 \uC790\uB3D9\uC73C\uB85C \uC774\uB8E8\uC5B4\uC9C4\uB2E4.
    \uC774\uB3D9\uACFC \uC870\uC900, \uD68C\uD53C\uC5D0 \uC9D1\uC911\uD55C\uB2E4."
  - "\uC6D0\uAC70\uB9AC \uBB34\uAE30\uB85C \uC2F8\uC6B4\uB2E4. \uBCF4\uC870 \uBB34\uAE30
    3\uCE78\uACFC \uCD1D\uAE30 \uBD80\uCC29\uBB3C\uC744 \uD65C\uC6A9\uD55C\uB2E4.
    \uADF8\uB9BC\uC744 \uB204\uB974\uBA74 \uD655\uB300\uB41C\uB2E4."
  - "\uB192\uC740 \uCCB4\uB825\uACFC \uADFC\uC811 \uACF5\uACA9\uC774 \uD2B9\uC9D5\uC774\uB2E4.
    \uBCF4\uC870 \uBB34\uAE30 2\uCE78\uACFC \uC11C\uBE0C \uB2A5\uB825 2\uAC1C\uB97C
    \uD65C\uC6A9\uD55C\uB2E4. \uADF8\uB9BC\uC744 \uB204\uB974\uBA74 \uD655\uB300\uB41C\uB2E4."
  - "\uB808\uBCA8\uC5C5 \uC2DC \uCE74\uB4DC\uAC00 \uB4F1\uC7A5\uD55C\uB2E4. \uACBD\uD5D8\uCE58\uB85C
    \uC2A4\uD0AC\uC744 \uD68D\uB4DD\uD558\uACE0, \uAC19\uC740 \uC2A4\uD0AC\uC744
    \uB2E4\uC2DC \uC120\uD0DD\uD558\uBA74 \uAC15\uD654\uB41C\uB2E4."
  - "\uBAAC\uC2A4\uD130 \uCC98\uCE58 \uC2DC \uB2E4\uC591\uD55C \uC544\uC774\uD15C\uC774
    \uB5A8\uC5B4\uC9C4\uB2E4."
  keys:
  - id: Esc
    label: "\uC124\uC815, \uC77C\uC2DC \uC815\uC9C0"
  - id: Move
    label: "\uC774\uB3D9"
  - id: Shift
    label: "\uB2EC\uB9AC\uAE30"
  - id: E
    label: "\uD2B9\uC218 \uB2A5\uB825 1"
  - id: R
    label: "\uC7A5\uC804"
  - id: Z
    label: "\uC7A5\uBE44 \uC815\uBCF4 \uBCF4\uAE30"
  - id: F
    label: "\uD2B9\uC218 \uB2A5\uB825 2 (\uAC80\uC0AC)"
  - id: Space
    label: "\uC810\uD504"
  - id: MouseLeft
    label: "\uBA54\uB274 \uC120\uD0DD"
  - id: MouseRight
    label: "\uD68C\uD53C (\uAD6C\uB974\uAE30 / \uD328\uB9C1)"
  - id: MouseMove
    label: "\uC6C0\uC9C1\uC5EC\uC11C \uC870\uC900, \uACF5\uACA9\uC740 \uC790\uB3D9"
  gunnerCards:
  - id: Roll
    tag: "\uD68C\uD53C, \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD"
    title: "\uAD6C\uB974\uAE30"
    text: "\uAD6C\uB974\uB294 \uB3D9\uC548 \uBB34\uC801 \uC0C1\uD0DC\uAC00 \uB41C\uB2E4.
      \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 4\uCD08"
  - id: GunMain
    tag: "\uC8FC\uBB34\uAE30"
    title: "\uC18C\uCD1D, \uAE30\uAD00\uB2E8\uCD1D, \uC2A4\uB098\uC774\uD37C"
    text: "\uC870\uC900 \uBC29\uD5A5\uC758 \uC801\uC744 \uC790\uB3D9\uC73C\uB85C
      \uACF5\uACA9\uD558\uACE0, R\uD0A4\uB85C \uC7AC\uC7A5\uC804\uD55C\uB2E4."
  - id: GunSupport
    tag: "\uBCF4\uC870 \uBB34\uAE30, 3\uCE78"
    title: "\uC790\uB3D9 \uC0AC\uACA9 \uBCF4\uC870 \uBB34\uAE30"
    text: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uAD6C\uB9E4\uD55C \uCD1D\uACFC \uB4DC\uB860\uC774
      \uC8FC\uBCC0\uC744 \uB3CC\uBA70 \uC790\uB3D9 \uACF5\uACA9\uD55C\uB2E4. \uC8FC\uBB34\uAE30\uBCF4\uB2E4
      \uC704\uB825\uC774 \uC57D\uD558\uB2E4."
  - id: Grenade
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uC720\uD0C4 \uBC1C\uC0AC\uAE30"
    text: "\uC870\uC900 \uBC29\uD5A5\uC73C\uB85C \uC720\uD0C4\uC744 \uBC1C\uC0AC\uD55C\uB2E4.
      \uCC29\uD0C4 \uC9C0\uC810\uC5D0\uC11C \uD3ED\uBC1C\uD574 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC900\uB2E4."
  - id: Shock
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uCDA9\uACA9 \uBC29\uCD9C\uAE30"
    text: "\uC8FC\uBCC0 \uC801\uC744 \uBC00\uCCD0\uB0B4\uACE0 \uC7A0\uC2DC \uC6C0\uC9C1\uC774\uC9C0
      \uBABB\uD558\uAC8C \uD55C\uB2E4."
  - id: Bayonet
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uCD1D\uAC80 \uB3CC\uACA9"
    text: "\uC870\uC900 \uBC29\uD5A5\uC73C\uB85C \uB3CC\uC9C4\uD558\uBA70 \uC801\uC744
      \uCC0C\uB978\uB2E4. \uB3CC\uC9C4 \uC911\uC5D0\uB294 \uBB34\uC801 \uC0C1\uD0DC\uAC00
      \uB41C\uB2E4."
  swordsmanCards:
  - id: Parry
    tag: "\uD68C\uD53C, \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD"
    title: "\uD328\uB9C1"
    text: "\uACF5\uACA9 \uD0C0\uC774\uBC0D\uC5D0 \uB9DE\uCDB0 \uD0C4\uD658\uC744
      \uD295\uACA8\uB0B4\uACE0 \uC801\uC744 \uBC00\uCCD0\uB0B8\uB2E4. \uC131\uACF5\uD558\uBA74
      \uBCF4\uC870 \uBB34\uAE30\uAC00 \uBC18\uACA9\uD55C\uB2E4."
  - id: SwordMain
    tag: "\uC8FC\uBB34\uAE30"
    title: "\uAC80, \uC804\uD22C \uB9DD\uCE58, \uBC29\uB9DD\uC774"
    text: "\uADFC\uCC98 \uC801\uC744 \uC790\uB3D9\uC73C\uB85C \uACF5\uACA9\uD55C\uB2E4.
      \uB9DD\uCE58\uB294 \uAE30\uC808, \uBC29\uB9DD\uC774\uB294 \uBC00\uCCD0\uB0B4\uAE30
      \uD6A8\uACFC\uAC00 \uC788\uB2E4."
  - id: SwordSupport
    tag: "\uBCF4\uC870 \uBB34\uAE30, 2\uCE78"
    title: "\uC790\uB3D9 \uACF5\uACA9 \uBCF4\uC870\uBB34\uAE30"
    text: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uAD6C\uB9E4\uD55C \uADFC\uC811 \uBB34\uAE30\uAC00
      \uC8FC\uBCC0\uC5D0 \uB5A0 \uC788\uB2E4\uAC00 \uC801\uC5D0\uAC8C \uB0A0\uC544\uAC00
      \uACF5\uACA9\uD55C\uB2E4."
  - id: Shield
    tag: "\uC11C\uBE0C \uB2A5\uB825, E"
    title: "\uC5D0\uB108\uC9C0 \uBC29\uD328"
    text: "\uB204\uB974\uB294 \uB3D9\uC548 \uC815\uBA74 \uACF5\uACA9\uC744 \uB9C9\uB294\uB2E4.
      \uBC84\uD2BC\uC744 \uB193\uC73C\uBA74 \uC804\uBC29\uC758 \uC801\uC744 \uBC00\uCCD0\uB0B8\uB2E4."
  - id: Grapple
    tag: "\uC11C\uBE0C \uB2A5\uB825, F"
    title: "\uADF8\uB7A9 \uD6C5"
    text: "\uC640\uC774\uC5B4\uB97C \uBC1C\uC0AC\uD574 \uCC98\uC74C \uC801\uC911\uD55C
      \uC801\uC744 \uC790\uC2E0 \uC55E\uC73C\uB85C \uB04C\uC5B4\uC628\uB2E4."
  swordsmanNoteTitle: "\uC11C\uBE0C \uB2A5\uB825 \uD0A4\uC6B0\uAE30"
  swordsmanNoteText: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uAD6C\uB9E4\uD574 \uAC15\uD654\uD55C\uB2E4.
    Lv.2\uC640 Lv.3\uC5D0\uC11C \uB450 \uAC00\uC9C0 \uBCC0\uD615 \uC911 \uD558\uB098\uB97C
    \uC120\uD0DD\uD560 \uC218 \uC788\uB2E4."
  zoomHint: "\u2190 \u2192 \uB2E4\uB978 \uADF8\uB9BC   ESC \uB3CC\uC544\uAC00\uAE30"
  zoomBadge: "+ \uD06C\uAC8C"
  skillLevelFormat: "\uCD5C\uB300 Lv{0}, \uD544\uC694 \uACBD\uD5D8\uCE58 {1}\uBD80\uD130"
  skillPairFormat: "{0}\uC758 \uC870\uD569 \u2192 {1}"
  statsName: "\uB2A5\uB825\uCE58 \uCE74\uB4DC"
  statsText: "\uACF5\uACA9\uB825, \uC774\uB3D9 \uC18D\uB3C4, \uD0C4\uC18D, \uCD5C\uB300
    \uCCB4\uB825, \uCCB4\uB825 \uD68C\uBCF5 \uB4F1 \uAE30\uBCF8 \uB2A5\uB825\uCE58\uB97C
    \uAC15\uD654\uD55C\uB2E4."
  evolutionTitle: "\uC0C1\uC704 \uBB34\uAE30 \uD68D\uB4DD \uBC29\uBC95"
  evolutionSteps:
  - "1. \uC815\uBE44 \uCC3D\uC5D0\uC11C \uBB34\uAE30\uB97C Lv3\uAE4C\uC9C0 \uAC15\uD654\uD55C\uB2E4"
  - "2. \uBB34\uAE30\uBCC4 \uC9C4\uD654\uC5D0 \uD544\uC694\uD55C \uC870\uD569 \uC7A5\uBE44\uB97C
    \uD655\uBCF4\uD55C\uB2E4. \uAC1C\uC870\uC640 \uC11C\uBE0C \uB2A5\uB825\uC740
    \uC815\uBE44 \uCC3D\uC5D0\uC11C \uAD6C\uB9E4\uD558\uACE0, \uC2A4\uD0AC\uC740
    \uB808\uBCA8\uC5C5 \uCE74\uB4DC\uB85C \uD68D\uB4DD\uD55C\uB2E4."
  - "3. \uC815\uBE44 \uCC3D \uCD5C\uC0C1\uB2E8 \uB610\uB294 \uC2A4\uD14C\uC774\uC9C0
    \uBCF4\uC0C1\uC73C\uB85C \uB4F1\uC7A5\uD558\uB294 \uC0C1\uC704 \uBB34\uAE30 \uCE74\uB4DC\uB97C
    \uC120\uD0DD\uD55C\uB2E4. (\uBB34\uB8CC)"
  evolutionNote: "\uB85C\uBE44 \uC870\uD569\uC2DD\uACFC \uC2A4\uD0AC \uCE74\uB4DC\uC5D0\uC11C
    \uD544\uC694 \uC7A5\uBE44\uB97C \uD655\uC778\uD560 \uC218 \uC788\uB2E4. \uBCF4\uC870
    \uBB34\uAE30\uB3C4 \uC9C4\uD654 \uAC00\uB2A5\uD558\uB2E4."
  items:
  - id: Exp
    name: "\uACBD\uD5D8\uCE58 \uAD6C\uC2AC"
    text: "\uBAAC\uC2A4\uD130 \uCC98\uCE58 \uC2DC \uB5A8\uC5B4\uC9C4\uB2E4. \uD68D\uB4DD\uD558\uBA74
      \uACBD\uD5D8\uCE58\uAC00 \uC313\uC5EC \uB808\uBCA8\uC774 \uC624\uB978\uB2E4."
  - id: Coin
    name: "\uD06C\uB808\uB527"
    text: "\uBAAC\uC2A4\uD130 \uCC98\uCE58 \uC2DC \uB5A8\uC5B4\uC9C4\uB2E4. \uC815\uBE44
      \uCC3D\uC5D0\uC11C \uBB34\uAE30\uC640 \uC7A5\uBE44\uB97C \uAD6C\uB9E4\uD558\uB294
      \uC7AC\uD654\uC774\uB2E4."
  - id: Magnet
    name: "\uC790\uC11D"
    text: "\uD68D\uB4DD \uC2DC \uC8FC\uBCC0\uC758 \uACBD\uD5D8\uCE58 \uAD6C\uC2AC\uACFC
      \uD06C\uB808\uB527\uC744 \uB04C\uC5B4\uC628\uB2E4."
  - id: Heal
    name: "\uD68C\uBCF5 \uD329"
    text: "\uD68D\uB4DD \uC2DC \uCCB4\uB825\uC744 25% \uD68C\uBCF5\uD55C\uB2E4. \uCCB4\uB825\uC774
      \uAC00\uB4DD \uCC28\uBA74 \uB4F1\uC7A5\uD558\uC9C0 \uC54A\uB294\uB2E4."
  - id: Beacon
    name: "\uC815\uBE44 \uC2E0\uD638\uAE30"
    text: "\uC2A4\uD14C\uC774\uC9C0 \uC911 \uD55C \uBC88 \uB4F1\uC7A5\uD55C\uB2E4.
      \uD654\uC0B4\uD45C\uB97C \uB530\uB77C\uAC00 \uC811\uCD09\uD558\uBA74 \uC815\uBE44
      \uCC3D\uC774 \uC5F4\uB9B0\uB2E4."
  itemNotes:
  - "\uC790\uC11D\uACFC \uD68C\uBCF5 \uD329\uC740 \uB4F1\uC7A5 \uD6C4 25\uCD08 \uB4A4
    \uC0AC\uB77C\uC9C4\uB2E4."
  - "\uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4 \uC2DC \uBC14\uB2E5\uC758 \uD06C\uB808\uB527\uC744
    \uBAA8\uB450 \uD68D\uB4DD\uD55C\uB2E4. \uBCF4\uC0C1 \uCE74\uB4DC 1\uC7A5\uACFC
    \uC815\uBE44 \uCC3D\uC774 \uC5F4\uB9B0\uB2E4."
