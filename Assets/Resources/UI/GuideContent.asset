  m_Script: {fileID: 11500000, guid: 4e3a01c68164e434fa31b7fb3282deb3, type: 3}
  m_Name: GuideContent
  m_EditorClassIdentifier: Assembly-CSharp::GuideContent
  windowTitle: "\uC870\uC791 \uAC00\uC774\uB4DC"
  buttonLabel: "\uC870\uC791 \uAC00\uC774\uB4DC"
  tabs:
  - "\uC870\uC791"
  - "\uC0AC\uC218"
  - "\uAC80\uC0AC"
  - "\uC2A4\uD0AC\uACFC \uC0C1\uC704 \uBB34\uAE30"
  - "\uC544\uC774\uD15C"
  leads:
  - "\uACF5\uACA9\uC740 \uC790\uB3D9\uC774\uB2E4. \uC6C0\uC9C1\uC774\uACE0, \uC870\uC900\uD558\uACE0,
    \uD53C\uD558\uB294 \uB370 \uC9D1\uC911\uD55C\uB2E4."
  - "\uCD1D\uC744 \uB4E4\uACE0 \uBA40\uB9AC\uC11C \uC2F8\uC6B4\uB2E4. \uBCF4\uC870
    \uBB34\uAE30 3\uCE78, \uCD1D\uC5D0 \uBD80\uCC29\uBB3C\uC744 \uB2EC\uC544 \uD0A4\uC6B4\uB2E4.
    \uADF8\uB9BC\uC744 \uB204\uB974\uBA74 \uD06C\uAC8C \uBCF8\uB2E4."
  - "\uADFC\uC811 \uBB34\uAE30\uB97C \uB4E4\uACE0 \uAC00\uAE4C\uC774\uC11C \uC2F8\uC6B4\uB2E4.
    \uCCB4\uB825\uC774 \uB9CE\uACE0, \uBCF4\uC870 \uBB34\uAE30 2\uCE78, \uC11C\uBE0C
    \uB2A5\uB825 \uB450 \uAC1C\uB97C \uC4F4\uB2E4. \uADF8\uB9BC\uC744 \uB204\uB974\uBA74
    \uD06C\uAC8C \uBCF8\uB2E4."
  - "\uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uCE74\uB4DC \uCC3D\uC774 \uC5F4\uB9B0\uB2E4.
    \uBAA8\uC740 \uACBD\uD5D8\uCE58\uB85C \uC2A4\uD0AC\uC744 \uC0AC\uACE0, \uAC19\uC740
    \uC2A4\uD0AC\uC744 \uB610 \uC0AC\uBA74 \uB808\uBCA8\uC774 \uC624\uB978\uB2E4
    (\uAC12\uB3C4 \uD568\uAED8 \uC624\uB978\uB2E4)."
  - "\uBAAC\uC2A4\uD130\uB97C \uC7A1\uB2E4 \uBCF4\uBA74 \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C0\uB294
    \uAC83\uB4E4\uC774\uB2E4."
  keys:
  - id: Esc
    label: "\uC124\uC815, \uC77C\uC2DC \uC815\uC9C0"
  - id: Move
    label: "\uC774\uB3D9"
  - id: Shift
    label: "\uB2EC\uB9AC\uAE30"
  - id: E
    label: "\uD2B9\uC218 \uB2A5\uB825 1"
  - id: R
    label: "\uC7A5\uC804"
  - id: Z
    label: "\uC7A5\uBE44 \uC815\uBCF4 \uBCF4\uAE30"
  - id: F
    label: "\uD2B9\uC218 \uB2A5\uB825 2 (\uAC80\uC0AC)"
  - id: Space
    label: "\uC810\uD504"
  - id: MouseLeft
    label: "\uBA54\uB274 \uC120\uD0DD"
  - id: MouseRight
    label: "\uD68C\uD53C (\uAD6C\uB974\uAE30 / \uD328\uB9C1)"
  - id: MouseMove
    label: "\uC6C0\uC9C1\uC5EC\uC11C \uC870\uC900, \uACF5\uACA9\uC740 \uC790\uB3D9"
  gunnerCards:
  - id: Roll
    tag: "\uD68C\uD53C, \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD"
    title: "\uAD6C\uB974\uAE30"
    text: "\uAD6C\uB974\uB294 \uB3D9\uC548\uC740 \uBB34\uC801\uC774\uB2E4. \uB0A0\uC544\uC624\uB294
      \uD0C4\uACFC \uACF5\uACA9\uC744 \uADF8\uB300\uB85C \uC9C0\uB098\uCE5C\uB2E4.
      \uB2E4\uC2DC \uC4F0\uAE30\uAE4C\uC9C0 4\uCD08"
  - id: GunMain
    tag: "\uC8FC\uBB34\uAE30"
    title: "\uC18C\uCD1D, \uAE30\uAD00\uB2E8\uCD1D, \uC2A4\uB098\uC774\uD37C"
    text: "\uB85C\uBE44\uC5D0\uC11C \uD558\uB098\uB97C \uACE0\uB978\uB2E4. \uC0AC\uAC70\uB9AC
      \uC548\uC758 \uC801\uC744 \uC870\uC900\uD55C \uCABD\uC73C\uB85C \uC2A4\uC2A4\uB85C
      \uC3DC\uB2E4. R \uB85C \uC7A5\uC804"
  - id: GunSupport
    tag: "\uBCF4\uC870 \uBB34\uAE30, 3\uCE78"
    title: "\uACC1\uC5D0 \uB5A0\uC11C \uC3D8\uB294 \uCD1D"
    text: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uC0B0 \uCD1D\uACFC \uB4DC\uB860\uC774
      \uBAB8 \uB458\uB808\uC5D0 \uB5A0\uC11C \uC2A4\uC2A4\uB85C \uC3DC\uB2E4. \uC190\uC5D0
      \uB4E0 \uAC83\uBCF4\uB2E4 \uC57D\uD558\uB2E4"
  - id: Grenade
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uC720\uD0C4 \uBC1C\uC0AC\uAE30"
    text: "\uC870\uC900\uD55C \uCABD\uC73C\uB85C \uC720\uD0C4\uC744 \uB358\uC9C4\uB2E4.
      \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uC5D0\uC11C \uD130\uC838 \uBB49\uCE5C \uC801\uC744
      \uD55C\uAEBC\uBC88\uC5D0 \uCE5C\uB2E4"
  - id: Shock
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uCDA9\uACA9 \uBC29\uCD9C\uAE30"
    text: "\uC8FC\uBCC0\uC758 \uC801\uC744 \uBC00\uCCD0 \uB0B4\uACE0 \uC7A0\uAE50
      \uBB36\uB294\uB2E4. \uB458\uB7EC\uC2F8\uC600\uC744 \uB54C \uC228\uC744 \uB3CC\uB9B0\uB2E4"
  - id: Bayonet
    tag: "\uD2B9\uC218 \uB2A5\uB825, E (\uD558\uBD80 \uBD80\uCC29\uBB3C)"
    title: "\uCD1D\uAC80 \uB3CC\uACA9"
    text: "\uC870\uC900\uD55C \uCABD\uC73C\uB85C \uC9E7\uAC8C \uB3CC\uC9C4\uD558\uBA70
      \uCC0C\uB978\uB2E4. \uB3CC\uC9C4\uD558\uB294 \uB3D9\uC548\uC740 \uBB34\uC801\uC774\uB2E4"
  swordsmanCards:
  - id: Parry
    tag: "\uD68C\uD53C, \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD"
    title: "\uD328\uB9C1"
    text: "\uB54C\uB97C \uB9DE\uCDB0 \uB9C9\uC73C\uBA74 \uB0A0\uC544\uC624\uB294
      \uD0C4\uC744 \uB418\uB3CC\uB824 \uBCF4\uB0B4\uACE0 \uC8FC\uBCC0\uC758 \uC801\uC744
      \uBC00\uCCD0 \uB0B8\uB2E4. \uC131\uACF5\uD558\uBA74 \uB5A0 \uC788\uB294 \uBB34\uAE30\uAC00
      \uBC18\uACA9\uD55C\uB2E4"
  - id: SwordMain
    tag: "\uC8FC\uBB34\uAE30"
    title: "\uAC80, \uB300\uAC80, \uCC3D"
    text: "\uB85C\uBE44\uC5D0\uC11C \uD558\uB098\uB97C \uACE0\uB978\uB2E4. \uAC00\uAE4C\uC774
      \uC628 \uC801\uC744 \uC2A4\uC2A4\uB85C \uBCA4\uB2E4"
  - id: SwordSupport
    tag: "\uBCF4\uC870 \uBB34\uAE30, 2\uCE78"
    title: "\uACC1\uC5D0 \uB5A0 \uC788\uB294 \uCE7C"
    text: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uC0B0 \uADFC\uC811 \uBB34\uAE30\uAC00
      \uBAB8 \uB458\uB808\uC5D0 \uB5A0 \uC788\uB2E4\uAC00 \uC801\uC5D0\uAC8C \uB0A0\uC544\uAC00
      \uBCA4\uB2E4"
  - id: Shield
    tag: "\uC11C\uBE0C \uB2A5\uB825, E"
    title: "\uC5D0\uB108\uC9C0 \uBC29\uD328"
    text: "\uB204\uB974\uACE0 \uC788\uB294 \uB3D9\uC548 \uC815\uBA74 \uACF5\uACA9\uC744
      \uB9C9\uB294\uB2E4. \uB5BC\uBA74 \uC55E\uC758 \uC801\uC744 \uBC00\uCCD0 \uB0B8\uB2E4"
  - id: Grapple
    tag: "\uC11C\uBE0C \uB2A5\uB825, F"
    title: "\uADF8\uB7A9 \uD6C5"
    text: "\uC640\uC774\uC5B4\uB97C \uC3D8\uC544 \uCC98\uC74C \uB2FF\uC740 \uC801\uC744
      \uB0B4 \uC55E\uAE4C\uC9C0 \uB04C\uC5B4\uC628\uB2E4"
  swordsmanNoteTitle: "\uC11C\uBE0C \uB2A5\uB825 \uD0A4\uC6B0\uAE30"
  swordsmanNoteText: "\uC815\uBE44 \uCC3D\uC5D0\uC11C \uC0AC\uACE0 \uB808\uBCA8\uC744
    \uC62C\uB9B0\uB2E4. Lv2, Lv3 \uC5D0\uC11C \uB450 \uAC00\uC9C0 \uBCC0\uD615 \uC911
    \uD558\uB098\uB97C \uACE0\uB978\uB2E4"
  zoomHint: "\u2190 \u2192 \uB2E4\uB978 \uADF8\uB9BC   ESC \uB3CC\uC544\uAC00\uAE30"
  zoomBadge: "+ \uD06C\uAC8C"
  skillLevelFormat: "\uCD5C\uB300 Lv{0}, \uAC12 {1}\uBD80\uD130"
  skillPairFormat: "{0}\uC758 \uC9DD \u2192 {1}"
  statsName: "\uB2A5\uB825\uCE58 \uCE74\uB4DC"
  statsText: "\uACF5\uACA9\uB825, \uC774\uB3D9 \uC18D\uB3C4, \uD0C4\uC18D, \uCD5C\uB300
    \uCCB4\uB825, \uCCB4\uB825 \uD68C\uBCF5. \uAC12\uC774 \uC2F8\uACE0 \uBA87 \uBC88\uC774\uB4E0
    \uC0B4 \uC218 \uC788\uB2E4"
  evolutionTitle: "\uC0C1\uC704 \uBB34\uAE30\uB97C \uC5BB\uB294 \uBC95"
  evolutionSteps:
  - "1. \uC815\uBE44 \uCC3D\uC5D0\uC11C \uBB34\uAE30\uB97C Lv3\uAE4C\uC9C0 \uAC15\uD654\uD55C\uB2E4"
  - "2. \uC9DD \uC7A5\uBE44\uB97C \uAC16\uCD98\uB2E4. \uAC1C\uC870\uC640 \uC11C\uBE0C
    \uB2A5\uB825\uC740 \uC815\uBE44 \uCC3D\uC5D0\uC11C \uC0AC\uACE0, \uC2A4\uD0AC\uC740
    \uB808\uBCA8\uC5C5 \uCE74\uB4DC\uB85C \uC5BB\uB294\uB2E4"
  - "3. \uC815\uBE44 \uCC3D \uB9E8 \uC55E\uC774\uB098 \uC2A4\uD14C\uC774\uC9C0 \uBCF4\uC0C1\uC5D0
    \uB728\uB294 \uC0C1\uC704 \uBB34\uAE30 \uCE74\uB4DC\uB97C \uACE0\uB978\uB2E4
    (\uBB34\uB8CC)"
  evolutionNote: "\uD544\uC694\uD55C \uC9DD\uC740 \uB85C\uBE44\uC758 \uC870\uD569\uC2DD\uC5D0
    \uB098\uC628\uB2E4. \uBCF4\uC870 \uCE78\uC758 \uBB34\uAE30\uB3C4 \uC9C4\uD654\uD55C\uB2E4"
  items:
  - id: Exp
    name: "\uACBD\uD5D8\uCE58 \uAD6C\uC2AC"
    text: "\uBAAC\uC2A4\uD130\uAC00 \uB5A8\uC5B4\uB728\uB9B0\uB2E4. \uAC00\uAE4C\uC774
      \uAC00\uBA74 \uBE68\uB824 \uC628\uB2E4. \uBAA8\uC73C\uBA74 \uB808\uBCA8\uC774
      \uC624\uB974\uACE0 \uC2A4\uD0AC \uCE74\uB4DC \uCC3D\uC774 \uC5F4\uB9B0\uB2E4"
  - id: Coin
    name: "\uD06C\uB808\uB527"
    text: "\uBAAC\uC2A4\uD130\uAC00 \uB5A8\uC5B4\uB728\uB9B0\uB2E4. \uC815\uBE44
      \uCC3D\uC5D0\uC11C \uBB34\uAE30\uC640 \uC7A5\uBE44\uB97C \uC0AC\uB294 \uB3C8\uC774\uB2E4"
  - id: Magnet
    name: "\uC790\uC11D"
    text: "\uAC00\uB054 \uB5A8\uC5B4\uC9C4\uB2E4. \uC8FC\uC6B0\uBA74 \uC8FC\uBCC0\uC758
      \uAD6C\uC2AC\uACFC \uD06C\uB808\uB527\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uB04C\uC5B4\uC628\uB2E4"
  - id: Heal
    name: "\uD68C\uBCF5 \uD329"
    text: "\uAC00\uB054 \uB5A8\uC5B4\uC9C4\uB2E4. \uCCB4\uB825\uC744 25% \uD68C\uBCF5\uD55C\uB2E4.
      \uCCB4\uB825\uC774 \uAC00\uB4DD\uC774\uBA74 \uC8FC\uC6CC\uC9C0\uC9C0 \uC54A\uB294\uB2E4"
  - id: Beacon
    name: "\uC815\uBE44 \uC2E0\uD638\uAE30"
    text: "\uC2A4\uD14C\uC774\uC9C0 \uC911\uAC04\uC5D0 \uD55C \uBC88 \uB098\uD0C0\uB09C\uB2E4.
      \uD654\uBA74\uC758 \uD654\uC0B4\uD45C\uB97C \uB530\uB77C\uAC00 \uB2FF\uC73C\uBA74
      \uC815\uBE44 \uCC3D\uC774 \uC5F4\uB9B0\uB2E4"
  itemNotes:
  - "\uC790\uC11D\uACFC \uD68C\uBCF5 \uD329\uC740 25\uCD08 \uB4A4 \uC0AC\uB77C\uC9C4\uB2E4.
    \uC0AC\uB77C\uC9C0\uAE30 5\uCD08 \uC804\uBD80\uD130 \uAE5C\uBE61\uC778\uB2E4."
  - "\uC2A4\uD14C\uC774\uC9C0\uB97C \uAE68\uBA74 \uBC14\uB2E5\uC5D0 \uB0A8\uC740
    \uD06C\uB808\uB527\uC774 \uBAA8\uB450 \uB4E4\uC5B4\uC624\uACE0, \uBCF4\uC0C1
    \uCE74\uB4DC \uD55C \uC7A5\uACFC \uC815\uBE44 \uCC3D\uC774 \uB098\uC628\uB2E4."
